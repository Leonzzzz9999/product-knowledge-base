{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/products",
      "dest": "/api/products.js"
    },
    {
      "src": "/api/products/.*",
      "dest": "/api/products.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
